rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function smallList() { return request.resource.data.keys().hasOnly(['items'])
                                  && request.resource.data.items is list
                                  && request.resource.data.items.size() <= 100; }

    // Admins: you add your own user id here once, in the Firebase console.
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // Shows you approved from submissions. Everyone reads; only admins write.
    match /shows/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: one document per visitor holding their reviews. Everyone reads.
    match /reviews/{uid} {
      allow read: if true;
      allow write: if (isMe(uid) && smallList()) || isAdmin();
    }

    // Show submissions: each visitor sees only their own; admins see all.
    match /submissions/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if (isMe(uid) && smallList()) || isAdmin();
    }

    // Email list: visitors can add or update their own signup; only admins read the list.
    match /subscribers/{uid} {
      allow read: if isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['email','area','joinedAt'])
        && request.resource.data.email is string && request.resource.data.email.size() < 200;
      allow delete: if isAdmin();
    }
  }
}
